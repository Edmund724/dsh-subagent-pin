{
  "name": "dsh-subagent-pin",
  "version": "1.1.0",
  "type": "module",
  "description": "Three DSH Host rows from one package: pin fresh subagent delegations to the configured LLM route, carry each conversation's id to OpenCode Go, and keep continuable subagents id-addressable while Agent Teams owns send_message.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "subagent",
    "llm-routing",
    "opencode",
    "agent-teams"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edmund724/dsh-subagent-pin.git"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin.js",
    "./subagent-pin": "./plugin.js",
    "./subagent-pin/package.json": "./package.json",
    "./subagent-pin/locale/*.json": "./locale/subagent-pin/*.json",
    "./opencode-header": "./opencode-header.js",
    "./opencode-header/package.json": "./opencode-header.package.json",
    "./opencode-header/locale/*.json": "./locale/opencode-header/*.json",
    "./subagent-steer": "./subagent-steer.js",
    "./subagent-steer/package.json": "./subagent-steer.package.json",
    "./subagent-steer/locale/*.json": "./locale/subagent-steer/*.json",
    "./verify": "./tools/verify-session.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node tools/verify-session.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "plugin.js",
    "opencode-header.js",
    "subagent-steer.js",
    "config-schema.js",
    "route-policy.js",
    "host-contract.js",
    "cordis.patch.yml",
    "README.md",
    "README-en.md",
    "CONTEXT.md",
    "LICENSE",
    "docs/**",
    "AGENTS.md",
    ".agents/notes/**",
    "locale/**",
    "icon.svg",
    "opencode-header.icon.svg",
    "opencode-header.package.json",
    "subagent-steer.icon.svg",
    "subagent-steer.package.json",
    "test/**",
    "test-support/**",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2"
  }
}
