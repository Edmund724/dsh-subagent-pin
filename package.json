{
  "name": "@local/dsh-subagent-pin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gives every fresh subagent delegation that names no route the configured LLM route.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin.js",
    "./verify": "./tools/verify-session.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node tools/verify-session.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "plugin.js",
    "config-schema.js",
    "route-policy.js",
    "host-contract.js",
    "cordis.patch.yml",
    "README.md",
    "README-en.md",
    "CONTEXT.md",
    "locale/*.json",
    "icon.svg",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2"
  }
}
