{
  "name": "@edmund724/dsh-subagent-pin",
  "version": "1.0.0",
  "type": "module",
  "description": "Gives every fresh subagent delegation that names no route the configured LLM route.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "subagent",
    "llm-routing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edmund724/dsh-subagent-pin.git"
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./plugin.js",
    "./verify": "./tools/verify-session.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node tools/verify-session.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "plugin.js",
    "config-schema.js",
    "route-policy.js",
    "host-contract.js",
    "cordis.patch.yml",
    "README.md",
    "README-en.md",
    "CONTEXT.md",
    "LICENSE",
    "docs/**",
    "AGENTS.md",
    ".agents/notes/**",
    "locale/*.json",
    "icon.svg",
    "test/**",
    "test-support/**",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2"
  }
}
